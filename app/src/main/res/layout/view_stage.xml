<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:background="@color/bg_1"
    android:layout_height="match_parent"
    style="@style/VerticalListDivided">

    <LinearLayout style="@style/HorizontalListDivided">

        <FrameLayout
            android:id="@+id/close_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/bg_1"
            android:paddingTop="12sp"
            android:paddingBottom="12sp">

            <ImageView
                android:src="@drawable/px_times"
                android:tint="@color/foreground"
                android:contentDescription="@string/altdescr_close"
                style="@style/Icon24" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:text="1:00"
            style="@style/Text" />
    </LinearLayout>

    <LinearLayout
        android:gravity="center"
        android:layout_weight="1"
        style="@style/VerticalListDivided">

        <TextView
            style="@style/H2_center"
            android:textColor="@color/accent_3"
            android:layout_marginBottom="@dimen/space_between_elements"
            android:text="Hola" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            style="@style/HorizontalListDivided">

            <FrameLayout
                android:id="@+id/prev_btn"
                style="@style/ImgFrame">

                <ImageView
                    android:src="@drawable/px_prev"
                    android:tint="@color/foreground"
                    android:contentDescription="prev"
                    style="@style/Icon24" />
            </FrameLayout>

            <com.rama.jaguar.BrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/next_btn"
                style="@style/ImgFrame">

                <ImageView
                    android:src="@drawable/px_next"
                    android:tint="@color/foreground"
                    android:contentDescription="prev"
                    style="@style/Icon24" />
            </FrameLayout>
        </LinearLayout>

        <View style="@style/Separator" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/HorizontalListDivided">

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.rama.jaguar.SmallBrailleBlock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    style="@style/VerticalListDivided">

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:background="@color/bg_4"
        android:useDefaultMargins="true">

        <FrameLayout
            android:id="@+id/small_dot_1"
            style="@style/BrailleSmallImgFrame">

            <ImageView style="@style/BrailleSmallDot" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/small_dot_2"
            style="@style/BrailleSmallImgFrame">

            <ImageView style="@style/BrailleSmallDot" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/small_dot_3"
            style="@style/BrailleSmallImgFrame">

            <ImageView style="@style/BrailleSmallDot" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/small_dot_4"
            style="@style/BrailleSmallImgFrame">

            <ImageView style="@style/BrailleSmallDot" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/small_dot_5"
            style="@style/BrailleSmallImgFrame">

            <ImageView style="@style/BrailleSmallDot" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/small_dot_6"
            style="@style/BrailleSmallImgFrame">

            <ImageView style="@style/BrailleSmallDot" />
        </FrameLayout>

    </GridLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HHH"
        style="@style/Text" />
</LinearLayout>